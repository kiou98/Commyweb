{
  "name": "commyweb-extension",
  "version": "1.7.1",
  "description": "Collaborative, open-source Figma-like website commenting Chrome extension (no database required)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser.mjs && node tests/realtime-browser.mjs",
    "test:site": "npm run build:site && node tests/site-browser.mjs",
    "capture:site": "npm run build && node scripts/capture-site.mjs",
    "relay": "node relay/server.mjs",
    "check": "npm test && npm run test:browser",
    "build": "tsc && vite build && vite build --config vite.content.config.ts",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "package": "npm run build && node scripts/package.js"
  },
  "keywords": [
    "chrome-extension",
    "figma-comments",
    "collaborative",
    "open-source",
    "no-database",
    "github-discussions"
  ],
  "author": "Commyweb Contributors",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.0",
    "archiver": "^7.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "ws": "^8.22.0"
  }
}
