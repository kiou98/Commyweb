{
  "name": "commyweb-extension",
  "version": "1.0.0",
  "description": "Collaborative, open-source Figma-like website commenting Chrome extension (no database required)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "package": "npm run build && node scripts/package.js"
  },
  "keywords": [
    "chrome-extension",
    "figma-comments",
    "collaborative",
    "open-source",
    "no-database",
    "github-discussions"
  ],
  "author": "Commyweb Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.0",
    "archiver": "^7.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
